POSTGRES_DB=worktrace
POSTGRES_USER=worktrace
POSTGRES_PASSWORD=
DEFAULT_OWNER_ID=
REPORT_ACCESS_TOKEN=
REPORT_TIMEZONE=Asia/Seoul
FRONTEND_ORIGIN=https://worktrace.cloud
APP_DOMAIN=worktrace.cloud
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generate interactively: node scripts/generate_password_hash.mjs
# Single-quote the generated hash to preserve literal dollar signs in Compose.
WORKTRACE_PASSWORD_HASH=
WORKTRACE_SESSION_SECRET=
BACKUP_RETENTION_DAYS=14
GITHUB_WEBHOOK_SECRET=
# Required for private repository reads; never commit a real token.
GITHUB_SYNC_TOKEN=
# Optional extra owner/repository values, comma-separated.
WORKTRACE_GITHUB_REPOSITORIES=
