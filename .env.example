# Root compose defaults for local development only.
# Copy to .env and adjust as needed. Do not commit real secrets.

COMPOSE_PROJECT_NAME=worktrace

POSTGRES_DB=worktrace
POSTGRES_USER=leegiyeon
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Docker Compose frontend server routes use the backend service name.
# For local frontend outside Docker, use frontend/.env.example instead.
WORKTRACE_BACKEND_URL=http://backend:8000
FRONTEND_ORIGIN=http://localhost:3000

# GitHub synchronization. The token is required for private repositories.
GITHUB_SYNC_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Optional comma-separated extra repositories. Known production repositories are always included.
# Example: Leegiyeon/hankkilog,Leegiyeon/pixel-pals-desktop
WORKTRACE_GITHUB_REPOSITORIES=

# OpenAI settings. Keep example values empty; configure real values only in .env.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local storage is the MVP default. S3/Supabase Storage adapters can be added later.
LOCAL_STORAGE_ROOT=/app/storage/uploads
# Local-only report access guard. Replace before any non-local exposure.
DEFAULT_OWNER_ID=local-owner
REPORT_ACCESS_TOKEN=
# The compose frontend maps these server-only values from DEFAULT_OWNER_ID/REPORT_ACCESS_TOKEN.
NEXT_PUBLIC_WORKTRACE_OWNER_ID=local-owner
REPORT_TIMEZONE=Asia/Seoul

# Optional locally; required in production. Enter the password at the hidden prompt:
# node scripts/generate_password_hash.mjs
# Single-quote the hash in Compose env files to preserve literal dollar signs.
WORKTRACE_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
WORKTRACE_SESSION_SECRET=
BACKUP_RETENTION_DAYS=14
